<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuração do IIS (hospedagem Windows da Locaweb) para o site estático. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Página 404 própria. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <rewrite>
      <rules>
        <!-- www -> sem www, para o Google ver um endereço só. -->
        <rule name="Remover www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.assertivarc\.com\.br$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="http://assertivarc.com.br/{R:1}" redirectType="Permanent" />
        </rule>
        <!--
          ATIVAR SÓ DEPOIS QUE O SSL ESTIVER FUNCIONANDO (https://assertivarc.com.br abrindo com cadeado).
          Leva todo acesso http para https. A pasta /.well-known fica de fora para o Let's Encrypt renovar sozinho.
          Ao ativar, troque também "http://" por "https://" na regra "Remover www" acima.
        <rule name="Forcar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://assertivarc.com.br/{R:1}" redirectType="Permanent" />
        </rule>
        -->
      </rules>
    </rewrite>

    <!-- Arquivos de /assets têm nome com hash: podem ficar 1 ano em cache no navegador. -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>

  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
